# Local Postgres (create a `url_shortener` database in pgAdmin first)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public"
# Example for AWS RDS Postgres:
# DATABASE_URL="postgresql://user:pass@host:5432/urlshortener?schema=public"

PORT=3001
PUBLIC_BASE_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:5173"

# JWT signing secret — change in production (use a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET="dev-secret-change-me"
